; CHECK:       mid:
; CHECK-NEXT:    [[V:%.*]] = icmp slt i32 [[X]], 18
; CHECK-NEXT:    ret i1 [[V]]
; CHECK:       else:
; CHECK-NEXT:    ret i1 false
;
entry:
  %q = sdiv exact i32 %x, 2
  %cmp = icmp slt i32 %q, 10
  br i1 %cmp, label %mid, label %else

mid:
  %v = icmp slt i32 %x, 18
  ret i1 %v

else:
  ret i1 false
}

