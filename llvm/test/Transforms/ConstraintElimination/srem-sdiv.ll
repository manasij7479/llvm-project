; =====================================================================
; sdiv exact: q = sdiv exact x, n  ==>  x = n*q  (tighter than |r| < n)
; =====================================================================

; sdiv exact gives tighter upper bound than non-exact.
; q = sdiv exact x, 2, q <s 10 => x <s 20 (exact: x = 2*q < 20)
; Compare with sdiv_tighter_upper_bound which also proves this,
; but sdiv exact can also prove x <s 19 — which non-exact cannot.
define i1 @sdiv_exact_tight_upper(i32 noundef %x) {
; CHECK-LABEL: define i1 @sdiv_exact_tight_upper(
; CHECK-SAME: i32 noundef [[X:%.*]]) {
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[Q:%.*]] = sdiv exact i32 [[X]], 2
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[Q]], 10
; CHECK-NEXT:    br i1 [[CMP]], label [[MID:%.*]], label [[ELSE:%.*]]
; CHECK:       mid:
; CHECK-NEXT:    ret i1 true
; CHECK:       else:
; CHECK-NEXT:    ret i1 false
;
entry:
  %q = sdiv exact i32 %x, 2
  %cmp = icmp slt i32 %q, 10
  br i1 %cmp, label %mid, label %else

mid:
  ; x = 2*q, q <= 9, so x <= 18 < 19
  %v = icmp slt i32 %x, 19
  ret i1 %v

else:
  ret i1 false
}

; Negative: sdiv exact x, 2 with q <s 10 cannot prove x <s 18.
; x = 2*q, q <= 9, so x <= 18. x <s 18 is NOT provable.
define i1 @sdiv_exact_tight_upper_neg(i32 noundef %x) {
; CHECK-LABEL: define i1 @sdiv_exact_tight_upper_neg(
; CHECK-SAME: i32 noundef [[X:%.*]]) {
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[Q:%.*]] = sdiv exact i32 [[X]], 2
