; sdiv with negative x: if x <=s -4 and q = sdiv x, 2, then q <=s -1
; (because 2*q < x + 2 <= -2, so q < -1, i.e. q <= -1... wait:
;  x <=s -4 means x <= -4. q = sdiv x, 2 rounds toward 0.
;  sdiv(-4, 2) = -2, sdiv(-5, 2) = -2. So q <= -2.
;  We want q <=s -1, which is weaker and should be provable.)
define i1 @sdiv_negative_x(i32 noundef %x) {
; CHECK-LABEL: define i1 @sdiv_negative_x(
; CHECK-SAME: i32 noundef [[X:%.*]]) {
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[CMP:%.*]] = icmp sle i32 [[X]], -4
; CHECK-NEXT:    br i1 [[CMP]], label [[MID:%.*]], label [[ELSE:%.*]]
; CHECK:       mid:
; CHECK-NEXT:    [[Q:%.*]] = sdiv i32 [[X]], 2
; CHECK-NEXT:    ret i1 true
; CHECK:       else:
; CHECK-NEXT:    ret i1 false
;
entry:
  %cmp = icmp sle i32 %x, -4
  br i1 %cmp, label %mid, label %else

mid:
  %q = sdiv i32 %x, 2
  %v = icmp sle i32 %q, -1
  ret i1 %v

else:
  ret i1 false
}

; srem with constant n > 0: |srem(x, n)| < n regardless of x's sign.
; So srem(x, 5) >=s -4 is always true.
define i1 @srem_abs_bound(i32 noundef %x) {
; CHECK-LABEL: define i1 @srem_abs_bound(
; CHECK-SAME: i32 noundef [[X:%.*]]) {
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[R:%.*]] = srem i32 [[X]], 5
; CHECK-NEXT:    ret i1 true
;
entry:
  %r = srem i32 %x, 5
  %v = icmp sge i32 %r, -4
  ret i1 %v
}

; srem(x, 5) <s 5 is always true.
define i1 @srem_upper_bound(i32 noundef %x) {
; CHECK-LABEL: define i1 @srem_upper_bound(
; CHECK-SAME: i32 noundef [[X:%.*]]) {
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[R:%.*]] = srem i32 [[X]], 5
; CHECK-NEXT:    ret i1 true
;
entry:
  %r = srem i32 %x, 5
  %v = icmp slt i32 %r, 5
  ret i1 %v
}

