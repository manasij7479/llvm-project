; =====================================================================
; sdiv coefficient-based constraints: q = sdiv x, n (constant n > 0)
;   From x = q*n + r, |r| < n:
;     n*q - n < x < n*q + n
; =====================================================================

; If x >=s 6 and q = sdiv x, 3, then q >=s 2 (because 3*q > x - 3 >= 3, so q > 1)
define i1 @sdiv_lower_bound(i32 noundef %x) {
; CHECK-LABEL: define i1 @sdiv_lower_bound(
; CHECK-SAME: i32 noundef [[X:%.*]]) {
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[CMP:%.*]] = icmp sge i32 [[X]], 6
; CHECK-NEXT:    br i1 [[CMP]], label [[MID:%.*]], label [[ELSE:%.*]]
; CHECK:       mid:
; CHECK-NEXT:    [[Q:%.*]] = sdiv i32 [[X]], 3
; CHECK-NEXT:    ret i1 true
; CHECK:       else:
; CHECK-NEXT:    ret i1 false
;
entry:
  %cmp = icmp sge i32 %x, 6
  br i1 %cmp, label %mid, label %else

mid:
  %q = sdiv i32 %x, 3
  %v = icmp sge i32 %q, 2
  ret i1 %v

else:
  ret i1 false
}

; If q = sdiv x, 2 and q <s 10, then x <s 22 (because x < 2*q + 2 <= 22)
define i1 @sdiv_upper_bound(i32 noundef %x) {
; CHECK-LABEL: define i1 @sdiv_upper_bound(
; CHECK-SAME: i32 noundef [[X:%.*]]) {
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[Q:%.*]] = sdiv i32 [[X]], 2
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[Q]], 10
; CHECK-NEXT:    br i1 [[CMP]], label [[MID:%.*]], label [[ELSE:%.*]]
; CHECK:       mid:
; CHECK-NEXT:    ret i1 true
; CHECK:       else:
; CHECK-NEXT:    ret i1 false
;
entry:
  %q = sdiv i32 %x, 2
  %cmp = icmp slt i32 %q, 10
  br i1 %cmp, label %mid, label %else

mid:
  %v = icmp slt i32 %x, 22
  ret i1 %v

else:
  ret i1 false
}

